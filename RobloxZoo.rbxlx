      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the map: ground, a central road, and one zoo plot per player slot.
-- Each plot has 8 fenced pens along a central path, with a sign post per pen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldBuilder = {}

export type Pen = {
	index: number,
	center: CFrame, -- top surface centre of the pen floor
	floor: Part,
	trough: Part,
	troughFill: Part,
	sign: Part,
	prompt: ProximityPrompt,
	statusLabel: TextLabel,
	animalsFolder: Folder,
}

export type Plot = {
	index: number,
	cframe: CFrame,
	folder: Folder,
	entrance: CFrame,
	ownerLabel: TextLabel,
	pens: { Pen },
}

local WOOD = Color3.fromRGB(125, 85, 50)
local PATH = Color3.fromRGB(190, 170, 140)
local LOCKED_FLOOR = Color3.fromRGB(95, 95, 95)

local PLOT_WIDTH = 76
local PLOT_DEPTH = 116
local PEN_ROW_X = 19 -- distance from the centre path to a pen's centre
local PEN_ZS = { -40, -12, 16, 44 }
local FLOOR_TOP = 0.8

local function makePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	return part
end

local function makeLabel(parent: Instance, text: string, textColor: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = textColor
	label.TextStrokeTransparency = 0.4
	label.Text = text
	label.Parent = parent
	return label
end

function WorldBuilder.buildEnvironment(): Folder
	local folder = Instance.new("Folder")
	folder.Name = "Environment"

	makePart({
		Name = "Ground",
		Size = Vector3.new(1600, 2, 1600),
		CFrame = CFrame.new(0, -1, 0),
		Color = Color3.fromRGB(95, 155, 70),
		Material = Enum.Material.Grass,
		Parent = folder,
	})

	-- Wild rings around the zoo, drawn as flat discs from the outside in.
	-- Rarer food grows in the outer rings.
	for ringIndex = #Config.Rings, 1, -1 do
		local ring = Config.Rings[ringIndex]
		makePart({
			Name = ring.name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, ring.outer * 2, ring.outer * 2),
			CFrame = CFrame.new(0, -0.1 + 0.02 * (#Config.Rings - ringIndex + 1), 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = ring.color,
			Material = ring.material,
			Parent = folder,
		})
	end
	makePart({
		Name = "ZooGrounds",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, Config.Rings[1].inner * 2, Config.Rings[1].inner * 2),
		CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(95, 155, 70),
		Material = Enum.Material.Grass,
		Parent = folder,
	})

	-- Signs at the edge of each ring saying what food grows there.
	for ringIndex, ring in Config.Rings do
		local foods = {}
		for _, food in Config.Foods do
			if food.ring == ringIndex then
				table.insert(foods, food.emoji .. " " .. food.name)
			end
		end
		local text = ring.name .. "\n" .. table.concat(foods, "  ")
		for i = 0, 3 do
			local angle = i * math.pi / 2 + math.pi / 4
			local position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (ring.inner + 4)
			local facing = CFrame.lookAt(position, Vector3.new(0, 0, 0))
			makePart({
				Name = "RingSignPost",
				Size = Vector3.new(0.6, 6, 0.6),
				CFrame = facing * CFrame.new(0, 3, 0),
				Color = WOOD,
				Material = Enum.Material.Wood,
				Parent = folder,
			})
			local board = makePart({
				Name = "RingSign",
				Size = Vector3.new(9, 3.5, 0.4),
				CFrame = facing * CFrame.new(0, 6.5, 0),
				Color = Color3.fromRGB(240, 225, 190),
				Material = Enum.Material.WoodPlanks,
				Parent = folder,
			})
			for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
				local gui = Instance.new("SurfaceGui")
				gui.Face = face
				gui.PixelsPerStud = 30
				gui.Parent = board
				makeLabel(gui, text, Color3.fromRGB(90, 55, 25))
			end
		end
	end

	makePart({
		Name = "Road",
		Size = Vector3.new(300, 0.2, 24),
		CFrame = CFrame.new(0, 0.1, 0),
		Color = Color3.fromRGB(70, 70, 75),
		Material = Enum.Material.Asphalt,
		Parent = folder,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, 0)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(240, 200, 80)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Parent = folder

	-- A welcome arch across the west end of the road.
	local welcome = makePart({
		Name = "WelcomeSign",
		Size = Vector3.new(24, 6, 1),
		CFrame = CFrame.new(-140, 14, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for _, side in { -1, 1 } do
		makePart({
			Name = "WelcomePost",
			Size = Vector3.new(1, 14, 1),
			CFrame = CFrame.new(-140, 7, side * 11),
			Color = WOOD,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.PixelsPerStud = 40
		gui.Parent = welcome
		makeLabel(gui, "🦁 Zoo Tycoon 🐘", Color3.fromRGB(255, 230, 120))
	end

	folder.Parent = workspace
	return folder
end

local function buildFence(parent: Instance, center: CFrame, size: number)
	local half = size / 2
	local postSpacing = 4
	local height = 3.5

	local sides = {
		{ from = Vector3.new(-half, 0, -half), to = Vector3.new(half, 0, -half) },
		{ from = Vector3.new(half, 0, -half), to = Vector3.new(half, 0, half) },
		{ from = Vector3.new(half, 0, half), to = Vector3.new(-half, 0, half) },
		{ from = Vector3.new(-half, 0, half), to = Vector3.new(-half, 0, -half) },
	}

	for _, side in sides do
		local delta = side.to - side.from
		local length = delta.Magnitude
		local direction = delta.Unit
		local posts = math.floor(length / postSpacing)
		for i = 0, posts - 1 do
			local p = side.from + direction * (i * postSpacing)
			makePart({
				Name = "Post",
				Size = Vector3.new(0.6, height, 0.6),
				CFrame = center * CFrame.new(p.X, height / 2, p.Z),
				Color = WOOD,
				Material = Enum.Material.Wood,
				Parent = parent,
			})
		end
		local mid = (side.from + side.to) / 2
		for _, railY in { 1.2, 2.8 } do
			local railMid = mid + Vector3.new(0, railY, 0)
			makePart({
				Name = "Rail",
				Size = Vector3.new(0.3, 0.3, length),
				CFrame = center * CFrame.lookAt(railMid, railMid + direction),
				Color = WOOD,
				Material = Enum.Material.Wood,
				Parent = parent,
			})
		end
	end
end

local function buildPen(plotFolder: Folder, plotCFrame: CFrame, index: number, side: number, localZ: number): Pen
	local penFolder = Instance.new("Folder")
	penFolder.Name = "Pen" .. index
	penFolder.Parent = plotFolder

	local size = Config.PenSize
	local localCenter = CFrame.new(side * PEN_ROW_X, 0, localZ)
	local floorCFrame = plotCFrame * localCenter * CFrame.new(0, FLOOR_TOP - 0.3, 0)
	local center = plotCFrame * localCenter * CFrame.new(0, FLOOR_TOP, 0)

	local floor = makePart({
		Name = "Floor",
		Size = Vector3.new(size, 0.6, size),
		CFrame = floorCFrame,
		Color = LOCKED_FLOOR,
		Material = Enum.Material.Concrete,
		Parent = penFolder,
	})

	buildFence(penFolder, center, size)

	-- Feed trough on the path side of the pen.
	local troughCFrame = center * CFrame.new(-side * (size / 2 - 2.5), 0.5, size / 2 - 5)
	local trough = makePart({
		Name = "Trough",
		Size = Vector3.new(2, 1, 5),
		CFrame = troughCFrame,
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		CanCollide = false,
		Parent = penFolder,
	})
	local troughFill = makePart({
		Name = "TroughFill",
		Size = Vector3.new(1.6, 0.2, 4.6),
		CFrame = troughCFrame * CFrame.new(0, 0.45, 0),
		Color = Color3.fromRGB(200, 180, 60),
		Material = Enum.Material.Grass,
		Transparency = 1,
		CanCollide = false,
		Parent = penFolder,
	})

	-- Sign post on the path, facing the path, holds the interaction prompt.
	local signBase = plotCFrame * CFrame.new(side * (PEN_ROW_X - size / 2 - 2), 0, localZ)
	makePart({
		Name = "SignPost",
		Size = Vector3.new(0.5, 4, 0.5),
		CFrame = signBase * CFrame.new(0, 2, 0),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = penFolder,
	})
	local sign = makePart({
		Name = "Sign",
		Size = Vector3.new(3.5, 2.2, 0.3),
		-- Face the sign toward the path (the sign's front is its -Z axis).
		CFrame = signBase * CFrame.new(0, 4.5, 0) * CFrame.Angles(0, side * math.rad(90), 0),
		Color = Color3.fromRGB(240, 225, 190),
		Material = Enum.Material.WoodPlanks,
		Parent = penFolder,
	})
	local signGui = Instance.new("SurfaceGui")
	signGui.Face = Enum.NormalId.Front
	signGui.PixelsPerStud = 50
	signGui.Parent = sign
	makeLabel(signGui, "Pen " .. index, Color3.fromRGB(90, 55, 25))

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(220, 50)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.MaxDistance = 70
	billboard.Parent = sign
	local statusLabel = makeLabel(billboard, "", Color3.new(1, 1, 1))

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Manage pen"
	prompt.ObjectText = "Pen " .. index
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = sign

	local animalsFolder = Instance.new("Folder")
	animalsFolder.Name = "Animals"
	animalsFolder.Parent = penFolder

	return {
		index = index,
		center = center,
		floor = floor,
		trough = trough,
		troughFill = troughFill,
		sign = sign,
		prompt = prompt,
		statusLabel = statusLabel,
		animalsFolder = animalsFolder,
	}
end

function WorldBuilder.buildPlot(index: number): Plot
	-- Three plots north of the road and three south, all opening onto the road.
	local column = (index - 1) % 3
	local north = index <= 3
	local x = (column - 1) * 90
	local z = if north then -(12 + PLOT_DEPTH / 2) else 12 + PLOT_DEPTH / 2
	-- The plot's local -Z points at the road.
	local rotation = if north then math.pi else 0
	local plotCFrame = CFrame.new(x, 0, z) * CFrame.Angles(0, rotation, 0)

	local folder = Instance.new("Folder")
	folder.Name = "Plot" .. index

	makePart({
		Name = "Base",
		Size = Vector3.new(PLOT_WIDTH, 0.4, PLOT_DEPTH),
		CFrame = plotCFrame * CFrame.new(0, 0.2, 0),
		Color = Color3.fromRGB(120, 175, 90),
		Material = Enum.Material.Grass,
		Parent = folder,
	})
	makePart({
		Name = "Path",
		Size = Vector3.new(12, 0.5, PLOT_DEPTH),
		CFrame = plotCFrame * CFrame.new(0, 0.25, 0),
		Color = PATH,
		Material = Enum.Material.Cobblestone,
		Parent = folder,
	})

	-- Entrance arch with the owner's name.
	local archZ = -PLOT_DEPTH / 2 + 1
	for _, side in { -1, 1 } do
		makePart({
			Name = "ArchPost",
			Size = Vector3.new(1.2, 12, 1.2),
			CFrame = plotCFrame * CFrame.new(side * 7, 6, archZ),
			Color = WOOD,
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	local archSign = makePart({
		Name = "ArchSign",
		Size = Vector3.new(16, 3.5, 0.8),
		CFrame = plotCFrame * CFrame.new(0, 11, archZ),
		Color = Color3.fromRGB(60, 120, 60),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	local ownerLabel: TextLabel? = nil
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.PixelsPerStud = 40
		gui.Parent = archSign
		local label = makeLabel(gui, "Empty Zoo", Color3.fromRGB(255, 245, 200))
		if face == Enum.NormalId.Front then
			ownerLabel = label
		else
			-- Keep both faces in sync.
			label.Name = "BackLabel"
		end
	end

	local pens = {}
	for i, penZ in PEN_ZS do
		table.insert(pens, buildPen(folder, plotCFrame, i * 2 - 1, -1, penZ))
		table.insert(pens, buildPen(folder, plotCFrame, i * 2, 1, penZ))
	end

	folder.Parent = workspace

	return {
		index = index,
		cframe = plotCFrame,
		folder = folder,
		-- Just inside the arch, facing into the zoo.
		entrance = plotCFrame * CFrame.new(0, 4, -PLOT_DEPTH / 2 + 6) * CFrame.Angles(0, math.pi, 0),
		ownerLabel = ownerLabel :: TextLabel,
		pens = pens,
	}
end

function WorldBuilder.setOwnerName(plot: Plot, text: string)
	plot.ownerLabel.Text = text
	local archSign = plot.folder:FindFirstChild("ArchSign")
	if archSign then
		for _, gui in archSign:GetChildren() do
			local back = gui:FindFirstChild("BackLabel")
			if back and back:IsA("TextLabel") then
				back.Text = text
			end
		end
	end
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">ZooService</string>
          <string name="Source"><![CDATA[--!strict
-- Core zoo logic: plots, pens, animals, food stores, growth, health, breeding, income and actions.
--
-- The server owns all game state. Each animal is a small "marker" instance
-- (tagged ZooAnimal) whose attributes hold its species, stage and wander target.
-- Clients build and animate the actual animal models from those markers, so the
-- server only sends a few attribute changes instead of moving parts every frame.

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local ForageService = require(script.Parent.ForageService)
local WorldBuilder = require(script.Parent.WorldBuilder)

type Species = Config.Species

type Animal = {
	id: string,
	species: Species,
	growth: number,
	hunger: number,
	health: number,
	stage: string,
	marker: Configuration,
	position: Vector3, -- where the animal is heading (or resting)
	nextMoveAt: number,
	warnedStarving: boolean,
}

type Pen = {
	index: number,
	unlocked: boolean,
	animals: { Animal },
	breedCooldown: number,
	storeFood: string?,
	storeAmount: number,
	world: WorldBuilder.Pen,
}

export type Zoo = {
	player: Player,
	plot: WorldBuilder.Plot,
	coins: number,
	pens: { Pen },
	discovered: { [string]: boolean },
	inventory: { [string]: number },
	equipment: { [string]: number },
	canSave: boolean,
	loaded: boolean,
	lastActionAt: number,
	coinsValue: IntValue,
	ratingValue: IntValue,
}

local ZooService = {}

local plots: { WorldBuilder.Plot } = {}
local plotOwners: { [number]: Player } = {}
local zoos: { [Player]: Zoo } = {}

local stateUpdate: RemoteEvent
local openPen: RemoteEvent
local notifyEvent: RemoteEvent
local actionEvent: RemoteEvent

local LOCKED_FLOOR = Color3.fromRGB(95, 95, 95)
local EMPTY_FLOOR = Color3.fromRGB(110, 160, 80)

local function notify(player: Player, text: string, kind: string?)
	notifyEvent:FireClient(player, text, kind or "info")
end

local function formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

---------------------------------------------------------------------------
-- State helpers
---------------------------------------------------------------------------

local function carried(zoo: Zoo): number
	local total = 0
	for _, amount in zoo.inventory do
		total += amount
	end
	return total
end

local function backpackCapacity(zoo: Zoo): number
	return Config.getEquipmentValue("Backpack", zoo.equipment.Backpack or 0)
end

local function storeCapacity(zoo: Zoo): number
	return Config.getEquipmentValue("Pantry", zoo.equipment.Pantry or 0)
end

local function computeRating(zoo: Zoo): number
	local rating = 0
	for _, pen in zoo.pens do
		for _, animal in pen.animals do
			if animal.stage == "Adult" then
				rating += animal.species.rating
			end
		end
	end
	for _ in zoo.discovered do
		rating += Config.DiscoveryRating
	end
	return rating
end

local function serialize(zoo: Zoo): DataService.SaveData
	local pens = {}
	for _, pen in zoo.pens do
		local animals = {}
		for _, animal in pen.animals do
			table.insert(animals, {
				species = animal.species.id,
				growth = math.floor(animal.growth * 10) / 10,
				hunger = math.floor(animal.hunger * 10) / 10,
				health = math.ceil(animal.health * 10) / 10,
			})
		end
		table.insert(pens, {
			unlocked = pen.unlocked,
			animals = animals,
			storeFood = pen.storeFood,
			storeAmount = math.floor(pen.storeAmount * 10) / 10,
		})
	end
	return {
		version = 2,
		coins = math.floor(zoo.coins),
		pens = pens,
		discovered = table.clone(zoo.discovered),
		inventory = table.clone(zoo.inventory),
		equipment = table.clone(zoo.equipment),
	}
end

local function penSpecies(pen: Pen): Species?
	local first = pen.animals[1]
	return if first then first.species else nil
end

local function buildClientState(zoo: Zoo)
	local capacity = storeCapacity(zoo)
	local pens = {}
	for _, pen in zoo.pens do
		local animals = {}
		for _, animal in pen.animals do
			table.insert(animals, {
				id = animal.id,
				species = animal.species.id,
				stage = animal.stage,
				growth = math.clamp(animal.growth / animal.species.growTime, 0, 1),
				hunger = animal.hunger / Config.HungerMax,
				health = animal.health / Config.HealthMax,
				sellPrice = Config.getSellPrice(animal.species, animal.growth),
			})
		end
		local species = penSpecies(pen)
		table.insert(pens, {
			unlocked = pen.unlocked,
			price = Config.getPenPrice(pen.index),
			species = if species then species.id else nil,
			animals = animals,
			storeFood = pen.storeFood,
			storeAmount = math.floor(pen.storeAmount),
			storeCapacity = capacity,
		})
	end
	return {
		coins = math.floor(zoo.coins),
		rating = computeRating(zoo),
		discovered = zoo.discovered,
		inventory = zoo.inventory,
		carried = carried(zoo),
		capacity = backpackCapacity(zoo),
		equipment = zoo.equipment,
		pens = pens,
	}
end

local function pushState(zoo: Zoo)
	if not zoo.loaded then
		return
	end
	zoo.coinsValue.Value = math.floor(zoo.coins)
	zoo.ratingValue.Value = computeRating(zoo)
	stateUpdate:FireClient(zoo.player, buildClientState(zoo))
end

---------------------------------------------------------------------------
-- Visuals
---------------------------------------------------------------------------

local function resetPenVisual(worldPen: WorldBuilder.Pen)
	worldPen.floor.Color = LOCKED_FLOOR
	worldPen.floor.Material = Enum.Material.Concrete
	worldPen.troughFill.Transparency = 1
	worldPen.statusLabel.Text = ""
end

local function setTroughFill(pen: Pen, fraction: number)
	local fill = pen.world.troughFill
	if fraction <= 0 then
		fill.Transparency = 1
		return
	end
	fill.Transparency = 0
	-- Grow the fill upward from the bottom of the trough.
	local height = 0.1 + 0.7 * math.clamp(fraction, 0, 1)
	local trough = pen.world.trough
	fill.Size = Vector3.new(fill.Size.X, height, fill.Size.Z)
	fill.CFrame = trough.CFrame * CFrame.new(0, -trough.Size.Y / 2 + 0.1 + height / 2, 0)
	local food = if pen.storeFood then pen.storeFood else ""
	fill.Color = if food == "Fish"
		then Color3.fromRGB(120, 170, 210)
		elseif food == "Meat" then Color3.fromRGB(190, 80, 80)
		elseif food == "Melon" then Color3.fromRGB(90, 160, 70)
		elseif food == "Carrot" then Color3.fromRGB(240, 140, 40)
		else Color3.fromRGB(200, 180, 60)
end

local function refreshPenVisual(zoo: Zoo, pen: Pen)
	local world = pen.world
	if not pen.unlocked then
		world.floor.Color = LOCKED_FLOOR
		world.floor.Material = Enum.Material.Concrete
		world.troughFill.Transparency = 1
		world.statusLabel.Text = "🔒 Unlock: " .. formatNumber(Config.getPenPrice(pen.index)) .. " coins"
		return
	end

	local capacity = storeCapacity(zoo)
	setTroughFill(pen, pen.storeAmount / capacity)

	local species = penSpecies(pen)
	if not species then
		world.floor.Color = EMPTY_FLOOR
		world.floor.Material = Enum.Material.Grass
		world.statusLabel.Text = "Empty pen — buy an animal!"
		return
	end

	world.floor.Color = species.habitat
	world.floor.Material = species.habitatMaterial

	local starving, hungry = 0, 0
	for _, animal in pen.animals do
		if animal.hunger <= 0 then
			starving += 1
		elseif animal.hunger <= Config.EatThreshold then
			hungry += 1
		end
	end

	local food = Config.FoodById[species.food]
	local text = string.format(
		"%s ×%d  %s %d/%d",
		species.name,
		#pen.animals,
		food.emoji,
		math.floor(pen.storeAmount),
		capacity
	)
	if starving > 0 then
		text ..= "  ⚠️ Starving!"
	elseif hungry > 0 and pen.storeAmount < 1 then
		text ..= "  🍽️ Needs food"
	end
	world.statusLabel.Text = text
end

---------------------------------------------------------------------------
-- Animals
---------------------------------------------------------------------------

local function randomPointInPen(pen: Pen, species: Species): Vector3
	-- Keep big animals away from the fence.
	local margin = math.max(2.5, species.visual.bodySize.Z / 2 + 1.5)
	local half = Config.PenSize / 2 - margin
	local offset = Vector3.new((math.random() * 2 - 1) * half, 0, (math.random() * 2 - 1) * half)
	return pen.world.center:PointToWorldSpace(offset)
end

local function animalSpeed(animal: Animal): number
	local speed = animal.species.speed * Config.StageScale[animal.stage]
	if animal.hunger <= 0 then
		speed *= 0.4
	end
	return math.max(1, speed)
end

local function updateMarker(animal: Animal)
	local marker = animal.marker
	marker:SetAttribute("Stage", animal.stage)
	marker:SetAttribute("Hungry", animal.hunger <= 0)
	-- Rounded so the attribute only replicates when it visibly changes.
	marker:SetAttribute("Health", math.ceil(animal.health / Config.HealthMax * 20) / 20)
end

local function spawnAnimal(
	pen: Pen,
	speciesId: string,
	growth: number,
	hunger: number,
	health: number,
	near: Vector3?
): Animal
	local species = Config.SpeciesById[speciesId]
	local position = near or randomPointInPen(pen, species)

	local marker = Instance.new("Configuration")
	marker.Name = species.name
	local animal: Animal = {
		id = HttpService:GenerateGUID(false),
		species = species,
		growth = growth,
		hunger = hunger,
		health = health,
		stage = Config.getStage(species, growth),
		marker = marker,
		position = position,
		nextMoveAt = os.clock() + math.random() * 3,
		warnedStarving = false,
	}
	marker:SetAttribute("Species", species.id)
	marker:SetAttribute("Target", position)
	marker:SetAttribute("Speed", animalSpeed(animal))
	updateMarker(animal)
	CollectionService:AddTag(marker, "ZooAnimal")
	marker.Parent = pen.world.animalsFolder

	table.insert(pen.animals, animal)
	return animal
end

local function removeAnimal(pen: Pen, animal: Animal)
	local index = table.find(pen.animals, animal)
	if index then
		table.remove(pen.animals, index)
	end
	animal.marker:Destroy()
end

local function wander(pen: Pen, animal: Animal, now: number)
	if now < animal.nextMoveAt then
		return
	end
	local target = randomPointInPen(pen, animal.species)
	local speed = animalSpeed(animal)
	local travelTime = (target - animal.position).Magnitude / speed
	animal.position = target
	animal.nextMoveAt = now + travelTime + 1 + math.random() * 4
	animal.marker:SetAttribute("Speed", speed)
	animal.marker:SetAttribute("Target", target)
end

---------------------------------------------------------------------------
-- Simulation
---------------------------------------------------------------------------

local function discover(zoo: Zoo, species: Species)
	if zoo.discovered[species.id] then
		return
	end
	zoo.discovered[species.id] = true
	local reward = species.price * Config.DiscoveryRewardMultiplier
	zoo.coins += reward
	notify(
		zoo.player,
		string.format("📖 New in your Zoo Book: %s! +%s coins", species.name, formatNumber(reward)),
		"success"
	)

	local count = 0
	for _ in zoo.discovered do
		count += 1
	end
	if count == #Config.Species then
		notify(zoo.player, "🏆 You raised every animal! Your Zoo Book is complete!", "success")
	end
end

-- Animals eat from the pen's food store when they get hungry.
local function eat(pen: Pen, animal: Animal)
	if animal.hunger > Config.EatThreshold or pen.storeAmount <= 0 then
		return
	end
	if pen.storeFood ~= animal.species.food then
		return
	end
	local meal = animal.species.mealSize
	local eaten = math.min(meal, pen.storeAmount)
	pen.storeAmount -= eaten
	if pen.storeAmount < 0.001 then
		pen.storeAmount = 0
	end
	animal.hunger = math.min(Config.HungerMax, animal.hunger + Config.HungerMax * eaten / meal)
end

local function tickZoo(zoo: Zoo, dt: number, now: number)
	local income = 0
	for _, pen in zoo.pens do
		local adults = 0
		local totalHunger = 0
		local dead: { Animal } = {}

		for _, animal in pen.animals do
			local species = animal.species
			local wasHungry = animal.hunger <= 0
			local oldHealthKey = math.ceil(animal.health / Config.HealthMax * 20)

			animal.hunger = math.max(0, animal.hunger - Config.HungerDrainPerSecond * dt)
			eat(pen, animal)

			if animal.hunger > 0 then
				-- Fed: grow, earn and heal.
				if animal.growth < species.growTime then
					local rate = if animal.hunger >= Config.WellFedThreshold then 1 else 0.5
					animal.growth = math.min(species.growTime, animal.growth + dt * rate)
				else
					income += species.income * dt
				end
				animal.health = math.min(Config.HealthMax, animal.health + Config.HealthRegenPerSecond * dt)
				if animal.health >= Config.HealthMax * 0.75 then
					animal.warnedStarving = false
				end
			else
				-- Starving: lose health.
				animal.health = math.max(0, animal.health - Config.StarveDamagePerSecond * dt)
				if not animal.warnedStarving and animal.health <= Config.HealthMax * 0.5 then
					animal.warnedStarving = true
					notify(
						zoo.player,
						string.format("⚠️ Your %s in pen %d is starving! Bring it food fast!", species.name, pen.index),
						"error"
					)
				end
			end

			if animal.health <= 0 then
				table.insert(dead, animal)
				continue
			end
			totalHunger += animal.hunger

			local isHungry = animal.hunger <= 0
			local stage = Config.getStage(species, animal.growth)
			local healthKey = math.ceil(animal.health / Config.HealthMax * 20)
			if stage ~= animal.stage or wasHungry ~= isHungry or healthKey ~= oldHealthKey then
				local grewUp = stage ~= animal.stage and stage == "Adult"
				animal.stage = stage
				updateMarker(animal)
				if grewUp then
					discover(zoo, species)
				end
				if isHungry and not wasHungry then
					notify(
						zoo.player,
						string.format("🍽️ Your %s in pen %d is out of food!", species.name, pen.index),
						"warning"
					)
				end
			end

			if animal.stage == "Adult" then
				adults += 1
			end
			wander(pen, animal, now)
		end

		for _, animal in dead do
			removeAnimal(pen, animal)
			notify(
				zoo.player,
				string.format("💀 Your %s in pen %d starved to death.", animal.species.name, pen.index),
				"error"
			)
		end

		-- Breeding: two well-fed adults and a free spot can produce a baby.
		pen.breedCooldown = math.max(0, pen.breedCooldown - dt)
		local species = penSpecies(pen)
		if
			species
			and adults >= 2
			and #pen.animals < Config.PenCapacity
			and pen.breedCooldown <= 0
			and totalHunger / #pen.animals >= Config.BreedMinHunger
			and math.random() < Config.BreedChancePerSecond * dt
		then
			pen.breedCooldown = Config.BreedCooldown
			local parent = pen.animals[math.random(1, #pen.animals)]
			spawnAnimal(pen, species.id, 0, Config.HungerMax, Config.HealthMax, parent.position)
			notify(zoo.player, string.format("🍼 A baby %s was born in pen %d!", species.name, pen.index), "success")
		end

		refreshPenVisual(zoo, pen)
	end
	zoo.coins += income
end

---------------------------------------------------------------------------
-- Player actions
---------------------------------------------------------------------------

local function getPen(zoo: Zoo, penIndex: any): Pen?
	if type(penIndex) ~= "number" or penIndex ~= math.floor(penIndex) then
		return nil
	end
	return zoo.pens[penIndex]
end

local function spend(zoo: Zoo, amount: number): boolean
	if zoo.coins < amount then
		notify(zoo.player, "Not enough coins! You need " .. formatNumber(amount) .. ".", "error")
		return false
	end
	zoo.coins -= amount
	return true
end

local function isNearPen(zoo: Zoo, pen: Pen): boolean
	local character = zoo.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	return (root.Position - pen.world.sign.Position).Magnitude <= Config.StockDistance
end

local actions: { [string]: (zoo: Zoo, ...any) -> () } = {}

function actions.UnlockPen(zoo: Zoo, penIndex: any)
	local pen = getPen(zoo, penIndex)
	if not pen or pen.unlocked then
		return
	end
	if spend(zoo, Config.getPenPrice(pen.index)) then
		pen.unlocked = true
		refreshPenVisual(zoo, pen)
		notify(zoo.player, string.format("🔓 Pen %d unlocked!", pen.index), "success")
	end
end

function actions.BuyAnimal(zoo: Zoo, penIndex: any, speciesId: any)
	local pen = getPen(zoo, penIndex)
	local species = if type(speciesId) == "string" then Config.SpeciesById[speciesId] else nil
	if not pen or not species or not pen.unlocked then
		return
	end
	local current = penSpecies(pen)
	if current and current ~= species then
		notify(zoo.player, "Each pen can only hold one kind of animal.", "error")
		return
	end
	if #pen.animals >= Config.PenCapacity then
		notify(zoo.player, "This pen is full!", "error")
		return
	end
	if spend(zoo, species.price) then
		if pen.storeFood ~= species.food then
			if pen.storeFood and pen.storeAmount >= 1 then
				local old = Config.FoodById[pen.storeFood]
				notify(zoo.player, string.format("The old %s in this pen's store went to waste.", old.name), "warning")
			end
			pen.storeFood = species.food
			pen.storeAmount = 0
		end
		spawnAnimal(pen, species.id, 0, Config.HungerMax, Config.HealthMax)
		refreshPenVisual(zoo, pen)
		local food = Config.FoodById[species.food]
		notify(
			zoo.player,
			string.format("🐾 A baby %s joined pen %d! It eats %s %s.", species.name, pen.index, food.emoji, food.name),
			"success"
		)
	end
end

function actions.StockPen(zoo: Zoo, penIndex: any)
	local pen = getPen(zoo, penIndex)
	if not pen or not pen.unlocked then
		return
	end
	local species = penSpecies(pen)
	if not species then
		notify(zoo.player, "Buy an animal first so you know what food to store.", "info")
		return
	end
	if not isNearPen(zoo, pen) then
		notify(zoo.player, "Walk up to the pen's sign to fill its food store.", "error")
		return
	end
	local food = Config.FoodById[species.food]
	local have = zoo.inventory[food.id] or 0
	if have <= 0 then
		notify(
			zoo.player,
			string.format(
				"You have no %s %s. Forage it in the %s!",
				food.emoji,
				food.name,
				Config.Rings[food.ring].name
			),
			"error"
		)
		return
	end
	pen.storeFood = food.id
	local space = math.floor(storeCapacity(zoo) - pen.storeAmount)
	if space <= 0 then
		notify(zoo.player, "This pen's food store is full!", "info")
		return
	end
	local amount = math.min(have, space)
	pen.storeAmount += amount
	if have - amount > 0 then
		zoo.inventory[food.id] = have - amount
	else
		zoo.inventory[food.id] = nil
	end
	refreshPenVisual(zoo, pen)
	notify(zoo.player, string.format("Stored %d %s %s in pen %d.", amount, food.emoji, food.name, pen.index), "success")
end

function actions.SellAnimal(zoo: Zoo, penIndex: any, animalId: any)
	local pen = getPen(zoo, penIndex)
	if not pen or type(animalId) ~= "string" then
		return
	end
	for _, animal in pen.animals do
		if animal.id == animalId then
			local price = Config.getSellPrice(animal.species, animal.growth)
			zoo.coins += price
			removeAnimal(pen, animal)
			refreshPenVisual(zoo, pen)
			notify(
				zoo.player,
				string.format("💰 Sold a %s for %s coins.", animal.species.name, formatNumber(price)),
				"success"
			)
			return
		end
	end
end

function actions.DropFood(zoo: Zoo, foodId: any)
	if type(foodId) ~= "string" or not zoo.inventory[foodId] then
		return
	end
	zoo.inventory[foodId] = nil
	local food = Config.FoodById[foodId]
	if food then
		notify(zoo.player, string.format("Dropped your %s %s.", food.emoji, food.name), "info")
	end
end

---------------------------------------------------------------------------
-- Players
---------------------------------------------------------------------------

-- Boots set how fast the player walks.
local function applyWalkSpeed(zoo: Zoo)
	local character = zoo.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = Config.getEquipmentValue("Boots", zoo.equipment.Boots or 0)
	end
end

local function teleportToPlot(zoo: Zoo, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root and zoos[zoo.player] == zoo then
		task.wait(0.2) -- let the default spawn finish first
		character:PivotTo(zoo.plot.entrance)
		applyWalkSpeed(zoo)
	end
end

local function claimPlot(player: Player): WorldBuilder.Plot?
	for index, plot in plots do
		if not plotOwners[index] then
			plotOwners[index] = player
			return plot
		end
	end
	return nil
end

local function releasePlot(zoo: Zoo)
	for _, pen in zoo.pens do
		for _, animal in table.clone(pen.animals) do
			removeAnimal(pen, animal)
		end
		resetPenVisual(pen.world)
		pen.world.prompt:SetAttribute("OwnerUserId", 0)
	end
	WorldBuilder.setOwnerName(zoo.plot, "Empty Zoo")
	plotOwners[zoo.plot.index] = nil
end

local function onPlayerAdded(player: Player)
	local plot = claimPlot(player)
	if not plot then
		task.delay(3, function()
			if player.Parent then
				notify(player, "All zoos are taken on this server. Try another server!", "error")
			end
		end)
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coinsValue = Instance.new("IntValue")
	coinsValue.Name = "Coins"
	coinsValue.Parent = leaderstats
	local ratingValue = Instance.new("IntValue")
	ratingValue.Name = "Rating"
	ratingValue.Parent = leaderstats
	leaderstats.Parent = player

	local pens: { Pen } = {}
	for i, worldPen in plot.pens do
		table.insert(pens, {
			index = i,
			unlocked = false,
			animals = {},
			breedCooldown = 0,
			storeFood = nil,
			storeAmount = 0,
			world = worldPen,
		})
		worldPen.prompt:SetAttribute("OwnerUserId", player.UserId)
	end

	local zoo: Zoo = {
		player = player,
		plot = plot,
		coins = 0,
		pens = pens,
		discovered = {},
		inventory = {},
		equipment = {},
		canSave = false,
		loaded = false,
		lastActionAt = 0,
		coinsValue = coinsValue,
		ratingValue = ratingValue,
	}
	zoos[player] = zoo
	WorldBuilder.setOwnerName(plot, player.DisplayName .. "'s Zoo")

	player.CharacterAdded:Connect(function(character)
		teleportToPlot(zoo, character)
	end)
	if player.Character then
		task.spawn(teleportToPlot, zoo, player.Character)
	end

	local data, canSave = DataService.load(player)
	if zoos[player] ~= zoo then
		return -- left while loading
	end

	zoo.coins = data.coins
	zoo.discovered = data.discovered
	zoo.inventory = data.inventory
	zoo.equipment = data.equipment
	zoo.canSave = canSave
	for i, savedPen in data.pens do
		local pen = pens[i]
		if pen then
			pen.unlocked = savedPen.unlocked
			pen.storeFood = savedPen.storeFood
			pen.storeAmount = savedPen.storeAmount
			for _, saved in savedPen.animals do
				spawnAnimal(pen, saved.species, saved.growth, saved.hunger, saved.health)
			end
			-- Older saves have no store yet: match it to the animals.
			local species = penSpecies(pen)
			if species and pen.storeFood ~= species.food then
				pen.storeFood = species.food
				pen.storeAmount = 0
			end
			refreshPenVisual(zoo, pen)
		end
	end
	zoo.loaded = true
	applyWalkSpeed(zoo)
	pushState(zoo)

	if not canSave then
		notify(player, "Saving is off in this session, so progress won't be kept.", "warning")
	end
end

local function saveZoo(zoo: Zoo)
	if zoo.canSave and zoo.loaded then
		DataService.save(zoo.player, serialize(zoo))
	end
end

local function onPlayerRemoving(player: Player)
	local zoo = zoos[player]
	if not zoo then
		return
	end
	zoos[player] = nil
	saveZoo(zoo)
	releasePlot(zoo)
end

---------------------------------------------------------------------------
-- Setup
---------------------------------------------------------------------------

local function createRemotes()
	local remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	local function remote(name: string): RemoteEvent
		local event = Instance.new("RemoteEvent")
		event.Name = name
		event.Parent = remotes
		return event
	end
	stateUpdate = remote("StateUpdate")
	openPen = remote("OpenPen")
	notifyEvent = remote("Notify")
	actionEvent = remote("Action")
	remotes.Parent = ReplicatedStorage
end

function ZooService.start()
	createRemotes()
	WorldBuilder.buildEnvironment()

	for i = 1, Config.MaxPlots do
		local plot = WorldBuilder.buildPlot(i)
		table.insert(plots, plot)
		for penIndex, worldPen in plot.pens do
			resetPenVisual(worldPen)
			worldPen.prompt:SetAttribute("OwnerUserId", 0)
			CollectionService:AddTag(worldPen.prompt, "PenPrompt")
			worldPen.prompt.Triggered:Connect(function(player)
				local zoo = zoos[player]
				if zoo and zoo.loaded and zoo.plot == plot then
					openPen:FireClient(player, penIndex)
				else
					local owner = plotOwners[i]
					notify(player, if owner then "This is " .. owner.DisplayName .. "'s zoo!" else "This zoo is empty.", "info")
				end
			end)
		end
	end

	-- Foraging and chests live in their own module and talk to zoos through this.
	ForageService.start({
		getZoo = function(player: Player): any
			local zoo = zoos[player]
			return if zoo and zoo.loaded then zoo else nil
		end,
		carried = function(zoo: any): number
			return carried(zoo)
		end,
		capacity = function(zoo: any): number
			return backpackCapacity(zoo)
		end,
		changed = function(zoo: any)
			applyWalkSpeed(zoo)
			-- Pantry upgrades change every pen's store size.
			for _, pen in (zoo :: Zoo).pens do
				refreshPenVisual(zoo, pen)
			end
			pushState(zoo)
		end,
		notify = notify,
	})

	actionEvent.OnServerEvent:Connect(function(player, actionName, ...)
		local zoo = zoos[player]
		if not zoo or not zoo.loaded or type(actionName) ~= "string" then
			return
		end
		local handler = actions[actionName]
		if not handler then
			return
		end
		local now = os.clock()
		if now - zoo.lastActionAt < 0.15 then
			return
		end
		zoo.lastActionAt = now
		handler(zoo, ...)
		pushState(zoo)
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Simulation tick.
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local now = os.clock()
			local dt = math.min(now - last, 5)
			last = now
			for _, zoo in zoos do
				if zoo.loaded then
					tickZoo(zoo, dt, now)
					pushState(zoo)
				end
			end
		end
	end)

	-- Autosave.
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, zoo in zoos do
				task.spawn(saveZoo, zoo)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, zoo in zoos do
			pending += 1
			task.spawn(function()
				saveZoo(zoo)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return ZooService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="12">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="13">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="15">
          <Properties>
            <string name="Name">AnimalAnimator</string>
            <string name="Source"><![CDATA[--!strict
-- Builds and animates animal models on the client.
-- The server creates a tagged "ZooAnimal" marker per animal with attributes:
--   Species (string), Stage (string), Hungry (bool), Target (Vector3), Speed (number)
-- This script turns each marker into a model that walks toward its Target.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local AnimalBuilder = require(ReplicatedStorage.Shared.AnimalBuilder)

local camera = workspace.CurrentCamera
local MAX_ANIMATE_DISTANCE = 300

type Tracked = {
	marker: Instance,
	model: Model,
	position: Vector3,
	yaw: number,
	stage: string,
	hungerGui: BillboardGui,
	bobClock: number,
	connections: { RBXScriptConnection },
}

local tracked: { [Instance]: Tracked } = {}

local folder = Instance.new("Folder")
folder.Name = "ClientAnimals"
folder.Parent = workspace

local function applyStage(entry: Tracked, stage: string)
	entry.stage = stage
	local scale = Config.StageScale[stage] or 1
	entry.model:ScaleTo(scale)
	local species = Config.SpeciesById[entry.marker:GetAttribute("Species") :: string]
	if species then
		local v = species.visual
		local height = v.legLength + v.bodySize.Y + v.headSize.Y
		if table.find(v.extras, "longNeck") then
			height += 4.5
		end
		-- The bubble is attached to the body, so offset from the body's centre.
		local bodyCenter = v.legLength + v.bodySize.Y / 2
		entry.hungerGui.StudsOffsetWorldSpace = Vector3.new(0, (height - bodyCenter) * scale + 1.2, 0)
	end
end

local function onMarkerAdded(marker: Instance)
	if tracked[marker] then
		return
	end
	local speciesId = marker:GetAttribute("Species")
	if type(speciesId) ~= "string" or not Config.SpeciesById[speciesId] then
		return
	end
	local target = marker:GetAttribute("Target")
	local position = if typeof(target) == "Vector3" then target else Vector3.zero

	local model = AnimalBuilder.build(speciesId)
	local yaw = math.random() * math.pi * 2
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0))

	-- Bubble above starving or hurt animals: a food icon and a health bar.
	local hungerGui = Instance.new("BillboardGui")
	hungerGui.Name = "HungerBubble"
	hungerGui.Size = UDim2.fromOffset(60, 52)
	hungerGui.MaxDistance = 80
	hungerGui.Adornee = model:FindFirstChild("Body") :: BasePart
	local label = Instance.new("TextLabel")
	label.Name = "Icon"
	label.Size = UDim2.new(1, 0, 0, 36)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Text = "🍖"
	label.Parent = hungerGui
	local barBack = Instance.new("Frame")
	barBack.Name = "HealthBar"
	barBack.Position = UDim2.fromOffset(4, 40)
	barBack.Size = UDim2.new(1, -8, 0, 8)
	barBack.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	barBack.BorderSizePixel = 0
	barBack.Parent = hungerGui
	local barFill = Instance.new("Frame")
	barFill.Name = "Fill"
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBack
	hungerGui.Parent = model

	model.Parent = folder

	local entry: Tracked = {
		marker = marker,
		model = model,
		position = position,
		yaw = yaw,
		stage = "Adult",
		hungerGui = hungerGui,
		bobClock = math.random() * 10,
		connections = {},
	}
	tracked[marker] = entry
	applyStage(entry, (marker:GetAttribute("Stage") :: string?) or "Baby")

	local function updateBubble()
		local hungry = marker:GetAttribute("Hungry") == true
		local health = (marker:GetAttribute("Health") :: number?) or 1
		hungerGui.Enabled = hungry or health < 1
		label.Text = if hungry then "🍖" else "❤️"
		barFill.Size = UDim2.fromScale(math.clamp(health, 0, 1), 1)
	end
	updateBubble()

	table.insert(
		entry.connections,
		marker:GetAttributeChangedSignal("Stage"):Connect(function()
			local stage = marker:GetAttribute("Stage")
			if type(stage) == "string" and stage ~= entry.stage then
				applyStage(entry, stage)
			end
		end)
	)
	table.insert(
		entry.connections,
		marker:GetAttributeChangedSignal("Hungry"):Connect(function()
			updateBubble()
		end)
	)
	table.insert(entry.connections, marker:GetAttributeChangedSignal("Health"):Connect(updateBubble))
end

local function onMarkerRemoved(marker: Instance)
	local entry = tracked[marker]
	if not entry then
		return
	end
	tracked[marker] = nil
	for _, connection in entry.connections do
		connection:Disconnect()
	end
	entry.model:Destroy()
end

local function angleDifference(a: number, b: number): number
	return (b - a + math.pi) % (2 * math.pi) - math.pi
end

RunService.Heartbeat:Connect(function(dt)
	local cameraPosition = camera.CFrame.Position
	for marker, entry in tracked do
		local target = marker:GetAttribute("Target")
		local speed = marker:GetAttribute("Speed")
		if typeof(target) ~= "Vector3" or type(speed) ~= "number" then
			continue
		end

		local offset = target - entry.position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		local distance = flat.Magnitude
		local moving = distance > 0.05

		if moving then
			local step = math.min(distance, speed * dt)
			entry.position += flat.Unit * step
			-- The model's front is -Z, so this yaw points it along its path.
			local desiredYaw = math.atan2(-flat.X, -flat.Z)
			entry.yaw += angleDifference(entry.yaw, desiredYaw) * math.min(1, dt * 8)
		end
		-- Keep height in sync with the target (floor top).
		entry.position = Vector3.new(entry.position.X, target.Y, entry.position.Z)

		if (entry.position - cameraPosition).Magnitude > MAX_ANIMATE_DISTANCE then
			continue
		end

		local bob = 0
		if moving then
			entry.bobClock += dt * speed * 1.5
			bob = math.abs(math.sin(entry.bobClock)) * 0.25 * (Config.StageScale[entry.stage] or 1)
		end
		entry.model:PivotTo(CFrame.new(entry.position + Vector3.new(0, bob, 0)) * CFrame.Angles(0, entry.yaw, 0))
	end
end)

CollectionService:GetInstanceAddedSignal("ZooAnimal"):Connect(onMarkerAdded)
CollectionService:GetInstanceRemovedSignal("ZooAnimal"):Connect(onMarkerRemoved)
for _, marker in CollectionService:GetTagged("ZooAnimal") do
	task.spawn(onMarkerAdded, marker)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="16">
          <Properties>
            <string name="Name">ZooUI</string>
            <string name="Source"><![CDATA[--!strict
-- All of the player's on-screen UI: coin/rating HUD, pen manager, Zoo Book and notifications.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local stateUpdate = remotes:WaitForChild("StateUpdate") :: RemoteEvent
local openPenEvent = remotes:WaitForChild("OpenPen") :: RemoteEvent
local notifyEvent = remotes:WaitForChild("Notify") :: RemoteEvent
local actionEvent = remotes:WaitForChild("Action") :: RemoteEvent

---------------------------------------------------------------------------
-- Style
---------------------------------------------------------------------------

local FONT = Enum.Font.FredokaOne
local PANEL = Color3.fromRGB(250, 243, 225)
local PANEL_DARK = Color3.fromRGB(230, 215, 185)
local TEXT = Color3.fromRGB(70, 50, 30)
local GREEN = Color3.fromRGB(90, 170, 80)
local ORANGE = Color3.fromRGB(235, 150, 50)
local RED = Color3.fromRGB(210, 80, 70)
local BLUE = Color3.fromRGB(70, 140, 210)
local GREY = Color3.fromRGB(160, 155, 145)

local NOTIFY_COLORS = {
	info = BLUE,
	success = GREEN,
	warning = ORANGE,
	error = RED,
}

local function formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

local function create(className: string, props: { [string]: any }, children: { any }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function corner(radius: number?): Instance
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

local function padding(px: number): Instance
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

local function label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = TEXT,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		if k ~= "MaxTextSize" then
			defaults[k] = v
		end
	end
	return create("TextLabel", defaults, { create("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 22 }) })
end

local function button(text: string, color: Color3, onClick: () -> ()): TextButton
	local b = create("TextButton", {
		BackgroundColor3 = color,
		Font = FONT,
		Text = text,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		AutoButtonColor = true,
	}, {
		corner(8),
		create("UITextSizeConstraint", { MaxTextSize = 20 }),
		create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }),
		create("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = color:Lerp(Color3.new(0, 0, 0), 0.3),
			Thickness = 2,
		}),
	})
	b.Activated:Connect(onClick)
	return b
end

local function bar(fill: number, color: Color3, text: string): Frame
	return create("Frame", {
		BackgroundColor3 = PANEL_DARK,
		Size = UDim2.new(1, 0, 0, 16),
	}, {
		corner(6),
		create("Frame", {
			Name = "Fill",
			BackgroundColor3 = color,
			Size = UDim2.fromScale(math.clamp(fill, 0, 1), 1),
		}, { corner(6) }),
		label({
			Name = "Text",
			Size = UDim2.fromScale(1, 1),
			Text = text,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeTransparency = 0.5,
			ZIndex = 2,
			MaxTextSize = 13,
		}),
	})
end

local function setBar(frame: Instance, fill: number, text: string)
	local fillFrame = frame:FindFirstChild("Fill") :: Frame
	fillFrame.Size = UDim2.fromScale(math.clamp(fill, 0, 1), 1)
	local textLabel = frame:FindFirstChild("Text") :: TextLabel
	textLabel.Text = text
end

---------------------------------------------------------------------------
-- Root and HUD
---------------------------------------------------------------------------

local screen = create("ScreenGui", {
	Name = "ZooUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local hud = create("Frame", {
	Name = "HUD",
	BackgroundColor3 = PANEL,
	Position = UDim2.fromOffset(12, 12),
	Size = UDim2.fromOffset(230, 184),
	Parent = screen,
}, { corner(12), padding(8) })

local coinsLabel = label({
	Text = "🪙 0",
	Size = UDim2.new(1, 0, 0, 28),
	MaxTextSize = 26,
	Parent = hud,
})
local ratingLabel = label({
	Text = "⭐ Rating 0",
	Position = UDim2.fromOffset(0, 30),
	Size = UDim2.new(1, 0, 0, 22),
	MaxTextSize = 20,
	Parent = hud,
})

local backpackLabel = label({
	Text = "🎒 0/15",
	Position = UDim2.fromOffset(0, 54),
	Size = UDim2.new(1, 0, 0, 22),
	MaxTextSize = 20,
	Parent = hud,
})
local carryingLabel = label({
	Text = "Empty — go forage!",
	Position = UDim2.fromOffset(0, 78),
	Size = UDim2.new(1, 0, 0, 20),
	MaxTextSize = 16,
	TextColor3 = Color3.fromRGB(110, 90, 70),
	Parent = hud,
})

local zooBookPanel: Frame
local renderZooBook: () -> ()
local gearPanel: Frame
local renderGear: (force: boolean) -> ()

local bookButton = button("📖 Zoo Book", BLUE, function()
	zooBookPanel.Visible = not zooBookPanel.Visible
	if zooBookPanel.Visible then
		gearPanel.Visible = false
		renderZooBook()
	end
end)
bookButton.Position = UDim2.fromOffset(0, 102)
bookButton.Size = UDim2.new(1, 0, 0, 30)
bookButton.Parent = hud

local gearButton = button("🧰 Gear & Foraging", ORANGE, function()
	gearPanel.Visible = not gearPanel.Visible
	if gearPanel.Visible then
		zooBookPanel.Visible = false
		renderGear(true)
	end
end)
gearButton.Position = UDim2.fromOffset(0, 136)
gearButton.Size = UDim2.new(1, 0, 0, 30)
gearButton.Parent = hud

---------------------------------------------------------------------------
-- Notifications
---------------------------------------------------------------------------

local toastList = create("Frame", {
	Name = "Toasts",
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -90),
	Size = UDim2.new(0.9, 0, 0, 300),
	Parent = screen,
}, {
	create("UISizeConstraint", { MaxSize = Vector2.new(420, 300) }),
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
	}),
})

local toastOrder = 0
local function showToast(text: string, kind: string)
	toastOrder += 1
	local toast = create("Frame", {
		BackgroundColor3 = NOTIFY_COLORS[kind] or BLUE,
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = toastOrder,
		Parent = toastList,
	}, {
		corner(10),
		padding(6),
		label({
			Text = text,
			Size = UDim2.fromScale(1, 1),
			TextColor3 = Color3.new(1, 1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			MaxTextSize = 18,
		}),
	})
	-- Keep at most 5 on screen.
	local toasts = {}
	for _, child in toastList:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #toasts - 5 do
		toasts[i]:Destroy()
	end
	task.delay(4, function()
		if toast.Parent then
			local tween = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

notifyEvent.OnClientEvent:Connect(function(text: string, kind: string)
	showToast(text, kind)
end)

---------------------------------------------------------------------------
-- Pen panel
---------------------------------------------------------------------------

type AnimalState = {
	id: string,
	species: string,
	stage: string,
	growth: number,
	hunger: number,
	health: number,
	sellPrice: number,
}
type PenState = {
	unlocked: boolean,
	price: number,
	species: string?,
	animals: { AnimalState },
	storeFood: string?,
	storeAmount: number,
	storeCapacity: number,
}
type State = {
	coins: number,
	rating: number,
	discovered: { [string]: boolean },
	inventory: { [string]: number },
	carried: number,
	capacity: number,
	equipment: { [string]: number },
	pens: { PenState },
}

local state: State? = nil
local openPenIndex: number? = nil
local openSign: BasePart? = nil
local penSignature = ""
local animalRows: { [string]: Frame } = {}

local penPanel = create("Frame", {
	Name = "PenPanel",
	BackgroundColor3 = PANEL,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -12, 0.5, 0),
	Size = UDim2.fromOffset(340, 440),
	Visible = false,
	Parent = screen,
}, { corner(14), padding(10), create("UISizeConstraint", { MaxSize = Vector2.new(340, 440) }) })

local penTitle = label({
	Text = "Pen",
	Size = UDim2.new(1, -40, 0, 32),
	MaxTextSize = 26,
	Parent = penPanel,
})

local closePenButton = button("✕", RED, function()
	penPanel.Visible = false
	openPenIndex = nil
	openSign = nil
end)
closePenButton.AnchorPoint = Vector2.new(1, 0)
closePenButton.Position = UDim2.new(1, 0, 0, 0)
closePenButton.Size = UDim2.fromOffset(36, 36)
closePenButton.Parent = penPanel

local penBody = create("ScrollingFrame", {
	Name = "Body",
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Position = UDim2.fromOffset(0, 44),
	Size = UDim2.new(1, 0, 1, -44),
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 6,
	ScrollBarImageColor3 = GREY,
	Parent = penPanel,
}, {
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	}),
})

local function clearBody()
	for _, child in penBody:GetChildren() do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
	animalRows = {}
end

local function addToBody(instance: GuiObject, order: number)
	instance.LayoutOrder = order
	instance.Parent = penBody
end

local function buildSpeciesCard(penIndex: number, species: Config.Species, coins: number): Frame
	local affordable = coins >= species.price
	local card = create("Frame", {
		BackgroundColor3 = PANEL_DARK,
		Size = UDim2.new(1, -8, 0, 64),
	}, { corner(10), padding(6) })
	label({
		Text = species.name,
		Size = UDim2.new(0.6, 0, 0, 24),
		Parent = card,
	})
	label({
		Text = string.format(
			"Eats %s • earns %s/s • grows %ds",
			Config.FoodById[species.food].emoji,
			formatNumber(species.income),
			species.growTime
		),
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(0.62, 0, 0, 22),
		MaxTextSize = 14,
		TextColor3 = Color3.fromRGB(110, 90, 70),
		Parent = card,
	})
	local buy = button("🪙 " .. formatNumber(species.price), if affordable then GREEN else GREY, function()
		actionEvent:FireServer("BuyAnimal", penIndex, species.id)
	end)
	buy.AnchorPoint = Vector2.new(1, 0.5)
	buy.Position = UDim2.new(1, 0, 0.5, 0)
	buy.Size = UDim2.new(0.36, 0, 0, 44)
	buy.Parent = card
	return card
end

local function buildAnimalRow(penIndex: number, animal: AnimalState): Frame
	local species = Config.SpeciesById[animal.species]
	local row = create("Frame", {
		BackgroundColor3 = PANEL_DARK,
		Size = UDim2.new(1, -8, 0, 100),
	}, { corner(10), padding(6) })
	label({
		Name = "Title",
		Text = animal.stage .. " " .. species.name,
		Size = UDim2.new(0.62, 0, 0, 22),
		Parent = row,
	})
	local growthBar = bar(0, GREEN, "")
	growthBar.Name = "Growth"
	growthBar.Position = UDim2.fromOffset(0, 26)
	growthBar.Size = UDim2.new(0.62, 0, 0, 18)
	growthBar.Parent = row
	local hungerBar = bar(0, ORANGE, "")
	hungerBar.Name = "Hunger"
	hungerBar.Position = UDim2.fromOffset(0, 48)
	hungerBar.Size = UDim2.new(0.62, 0, 0, 18)
	hungerBar.Parent = row
	local healthBar = bar(1, RED, "")
	healthBar.Name = "Health"
	healthBar.Position = UDim2.fromOffset(0, 70)
	healthBar.Size = UDim2.new(0.62, 0, 0, 18)
	healthBar.Parent = row

	local sell = button("Sell", RED, function()
		actionEvent:FireServer("SellAnimal", penIndex, animal.id)
	end)
	sell.Name = "Sell"
	sell.AnchorPoint = Vector2.new(1, 0.5)
	sell.Position = UDim2.new(1, 0, 0.5, 0)
	sell.Size = UDim2.new(0.34, 0, 0, 44)
	sell.Parent = row
	return row
end

local function updateAnimalRow(row: Frame, animal: AnimalState)
	local growthText = if animal.stage == "Adult"
		then "Fully grown!"
		else string.format("Growing %d%%", math.floor(animal.growth * 100))
	setBar(row:FindFirstChild("Growth") :: Frame, animal.growth, growthText)
	local hungerText = if animal.hunger <= 0
		then "Starving!"
		else string.format("Full %d%%", math.ceil(animal.hunger * 100))
	setBar(row:FindFirstChild("Hunger") :: Frame, animal.hunger, hungerText)
	setBar(
		row:FindFirstChild("Health") :: Frame,
		animal.health,
		string.format("Health %d%%", math.ceil(animal.health * 100))
	)
	local sell = row:FindFirstChild("Sell") :: TextButton
	sell.Text = "Sell 🪙" .. formatNumber(animal.sellPrice)
	local title = row:FindFirstChild("Title") :: TextLabel
	title.Text = animal.stage .. " " .. Config.SpeciesById[animal.species].name
end

local footerButtons: { [string]: TextButton } = {}

local function renderPen()
	if not openPenIndex or not state then
		return
	end
	local currentState = state :: State
	local penIndex = openPenIndex :: number
	local pen = currentState.pens[penIndex]
	if not pen then
		return
	end

	-- Rebuild only when the layout changes; otherwise update text in place so
	-- buttons keep working while the player clicks them.
	local parts = { tostring(penIndex), tostring(pen.unlocked), pen.species or "-" }
	for _, animal in pen.animals do
		table.insert(parts, animal.id)
	end
	if not pen.species or #pen.animals == 0 then
		-- Shop cards change colour when the player can afford them.
		for _, species in Config.Species do
			table.insert(parts, tostring(currentState.coins >= species.price))
		end
	end
	local signature = table.concat(parts, "|")
	local rebuild = signature ~= penSignature
	penSignature = signature

	local species = if pen.species then Config.SpeciesById[pen.species] else nil
	penTitle.Text = if species
		then string.format("Pen %d — %s", penIndex, species.name)
		else string.format("Pen %d", penIndex)

	if rebuild then
		clearBody()
		footerButtons = {}
		if not pen.unlocked then
			addToBody(
				label({
					Text = "🔒 This pen is locked. Unlock it to raise more animals!",
					Size = UDim2.new(1, -8, 0, 48),
					TextWrapped = true,
					MaxTextSize = 18,
				}),
				1
			)
			local unlock = button("Unlock for 🪙 " .. formatNumber(pen.price), GREEN, function()
				actionEvent:FireServer("UnlockPen", penIndex)
			end)
			unlock.Size = UDim2.new(1, -8, 0, 44)
			addToBody(unlock, 2)
		elseif #pen.animals == 0 then
			addToBody(
				label({
					Text = "Pick a baby animal to raise. Keep its food store stocked so it grows into an adult that earns coins!",
					Size = UDim2.new(1, -8, 0, 54),
					TextWrapped = true,
					MaxTextSize = 15,
				}),
				1
			)
			for i, s in Config.Species do
				addToBody(buildSpeciesCard(penIndex, s, currentState.coins), i + 1)
			end
		else
			for i, animal in pen.animals do
				local row = buildAnimalRow(penIndex, animal)
				animalRows[animal.id] = row
				addToBody(row, i)
			end

			local storeBar = bar(0, ORANGE, "")
			storeBar.Name = "Store"
			storeBar.Size = UDim2.new(1, -8, 0, 24)
			addToBody(storeBar, 99)

			local stock = button("", ORANGE, function()
				actionEvent:FireServer("StockPen", penIndex)
			end)
			stock.Size = UDim2.new(1, -8, 0, 44)
			addToBody(stock, 100)
			footerButtons.stock = stock

			if species and #pen.animals < Config.PenCapacity then
				local buyMore = button("", GREEN, function()
					actionEvent:FireServer("BuyAnimal", penIndex, species.id)
				end)
				buyMore.Size = UDim2.new(1, -8, 0, 44)
				addToBody(buyMore, 101)
				footerButtons.buyMore = buyMore
			end

			addToBody(
				label({
					Name = "Tip",
					Text = "",
					Size = UDim2.new(1, -8, 0, 40),
					TextWrapped = true,
					MaxTextSize = 14,
					TextColor3 = Color3.fromRGB(110, 90, 70),
				}),
				102
			)
		end
	end

	-- In-place updates.
	for _, animal in pen.animals do
		local row = animalRows[animal.id]
		if row then
			updateAnimalRow(row, animal)
		end
	end
	local food = if species then Config.FoodById[species.food] else nil
	local storeBar = penBody:FindFirstChild("Store")
	if storeBar and food then
		setBar(
			storeBar,
			pen.storeAmount / math.max(1, pen.storeCapacity),
			string.format("%s %s store: %d / %d", food.emoji, food.name, pen.storeAmount, pen.storeCapacity)
		)
	end
	if footerButtons.stock and food then
		local have = currentState.inventory[food.id] or 0
		footerButtons.stock.Text = if have > 0
			then string.format("Fill store from backpack (%s %d)", food.emoji, have)
			else string.format("No %s %s — forage in the %s", food.emoji, food.name, Config.Rings[food.ring].name)
		footerButtons.stock.BackgroundColor3 = if have > 0 then ORANGE else GREY
	end
	if footerButtons.buyMore and species then
		footerButtons.buyMore.Text = string.format("Buy another %s 🪙 %s", species.name, formatNumber(species.price))
	end
	local tip = penBody:FindFirstChild("Tip") :: TextLabel?
	if tip and species then
		local adults = 0
		for _, animal in pen.animals do
			if animal.stage == "Adult" then
				adults += 1
			end
		end
		local starving = false
		for _, animal in pen.animals do
			if animal.hunger <= 0 then
				starving = true
			end
		end
		if starving then
			tip.Text = "⚠️ Starving animals lose health and die at 0. Fill the food store!"
		elseif #pen.animals >= Config.PenCapacity then
			tip.Text = "This pen is full. Sell an animal to make room."
		elseif adults >= 2 then
			tip.Text = "💕 Two well-fed adults may have a baby soon!"
		else
			tip.Text = "Animals eat from the store by themselves. Two well-fed adults can have babies."
		end
	end
end

openPenEvent.OnClientEvent:Connect(function(penIndex: number)
	openPenIndex = penIndex
	penSignature = ""
	penPanel.Visible = true
	renderPen()
end)

