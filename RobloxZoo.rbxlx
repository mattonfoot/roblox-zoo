      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">AnimalBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds simple blocky animal models out of parts, so the game needs no uploaded assets.
-- Models are built facing -Z with their feet at y = 0, and the pivot sits on the ground
-- under the body. That lets Model:ScaleTo grow an animal without lifting it off the floor.

local Config = require(script.Parent.Config)

local AnimalBuilder = {}

local BLACK = Color3.fromRGB(25, 25, 25)
local WHITE = Color3.fromRGB(245, 245, 245)
local PINK = Color3.fromRGB(240, 170, 170)
local ORANGE = Color3.fromRGB(245, 160, 40)
local BROWN = Color3.fromRGB(120, 75, 35)
local IVORY = Color3.fromRGB(250, 245, 225)

local function makePart(
	model: Model,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	if shape then
		part.Shape = shape
	end
	part.Parent = model
	return part
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local function addEyes(model: Model, head: CFrame, headSize: Vector3)
	local eyeSize = math.max(0.2, headSize.X * 0.18)
	local frontZ = -headSize.Z / 2
	for _, side in { -1, 1 } do
		makePart(
			model,
			"Eye",
			Vector3.new(eyeSize, eyeSize, eyeSize),
			head * at(side * headSize.X * 0.25, headSize.Y * 0.15, frontZ),
			BLACK,
			Enum.PartType.Ball
		)
	end
end

local function buildQuadruped(model: Model, v: Config.Visual)
	local body = v.bodySize
	local legLength = v.legLength
	local bodyY = legLength + body.Y / 2
	makePart(model, "Body", body, at(0, bodyY, 0), v.bodyColor)

	-- Legs at the four corners of the body.
	local legWidth = math.min(body.X, body.Z) * 0.28
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			makePart(
				model,
				"Leg",
				Vector3.new(legWidth, legLength + 0.2, legWidth),
				at(sx * (body.X / 2 - legWidth / 2), (legLength + 0.2) / 2, sz * (body.Z / 2 - legWidth / 2)),
				v.legColor
			)
		end
	end

	-- Head, raised on a neck for giraffes.
	local hasLongNeck = table.find(v.extras, "longNeck") ~= nil
	local head: CFrame
	if hasLongNeck then
		local neckHeight = 4.5
		local neckBaseZ = -(body.Z / 2 - 0.5)
		makePart(
			model,
			"Neck",
			Vector3.new(0.9, neckHeight, 0.9),
			at(0, legLength + body.Y + neckHeight / 2 - 0.6, neckBaseZ) * CFrame.Angles(math.rad(-12), 0, 0),
			v.bodyColor
		)
		head = at(0, legLength + body.Y + neckHeight - 0.2, neckBaseZ - 0.9)
	else
		head = at(0, legLength + body.Y * 0.85, -(body.Z / 2 + v.headSize.Z * 0.3))
	end
	makePart(model, "Head", v.headSize, head, v.headColor)
	addEyes(model, head, v.headSize)

	local h = v.headSize
	for _, extra in v.extras do
		if extra == "longEars" then
			for _, side in { -1, 1 } do
				makePart(
					model,
					"Ear",
					Vector3.new(0.3, 1.4, 0.45),
					head * at(side * h.X * 0.25, h.Y / 2 + 0.6, 0.1) * CFrame.Angles(0, 0, side * math.rad(-10)),
					v.headColor
				)
				makePart(
					model,
					"InnerEar",
					Vector3.new(0.15, 1.1, 0.05),
					head * at(side * h.X * 0.25, h.Y / 2 + 0.6, -0.13) * CFrame.Angles(0, 0, side * math.rad(-10)),
					PINK
				)
			end
		elseif extra == "puffTail" then
			makePart(model, "Tail", Vector3.new(0.7, 0.7, 0.7), at(0, bodyY + 0.2, body.Z / 2), WHITE, Enum.PartType.Ball)
		elseif extra == "horns" then
			for _, side in { -1, 1 } do
				makePart(
					model,
					"Horn",
					Vector3.new(0.25, 1.0, 0.25),
					head * at(side * h.X * 0.25, h.Y / 2 + 0.4, 0.3) * CFrame.Angles(math.rad(30), 0, 0),
					Color3.fromRGB(90, 80, 70)
				)
			end
		elseif extra == "beard" then
			makePart(
				model,
				"Beard",
				Vector3.new(0.35, 0.7, 0.3),
				head * at(0, -h.Y / 2 - 0.3, -h.Z * 0.3),
				Color3.fromRGB(240, 235, 225)
			)
		elseif extra == "stripes" then
			for i = -3, 3 do
				makePart(
					model,
					"Stripe",
					Vector3.new(body.X + 0.06, body.Y + 0.06, 0.3),
					at(0, bodyY, i * body.Z / 8),
					BLACK
				)
			end
			for _, side in { -1, 1 } do
				makePart(
					model,
					"HeadStripe",
					Vector3.new(0.06, h.Y * 0.8, 0.25),
					head * at(side * h.X / 2, 0, 0.2),
					BLACK
				)
			end
		elseif extra == "mane" then
			makePart(
				model,
				"Mane",
				Vector3.new(0.35, 0.5, body.Z * 0.45),
				at(0, legLength + body.Y + 0.2, -body.Z * 0.22),
				BLACK
			)
		elseif extra == "roundEars" then
			for _, side in { -1, 1 } do
				makePart(
					model,
					"Ear",
					Vector3.new(0.8, 0.8, 0.8),
					head * at(side * h.X * 0.4, h.Y / 2, 0.2),
					BLACK,
					Enum.PartType.Ball
				)
			end
		elseif extra == "eyePatches" then
			for _, side in { -1, 1 } do
				makePart(
					model,
					"EyePatch",
					Vector3.new(0.6, 0.7, 0.1),
					head * at(side * h.X * 0.25, h.Y * 0.12, -h.Z / 2 + 0.02),
					BLACK
				)
			end
			-- Black shoulder band, like a real panda.
			makePart(
				model,
				"Band",
				Vector3.new(body.X + 0.06, body.Y + 0.06, body.Z * 0.3),
				at(0, bodyY, -body.Z * 0.15),
				BLACK
			)
		elseif extra == "lionMane" then
			makePart(
				model,
				"Mane",
				Vector3.new(h.X * 1.6, h.Y * 1.6, h.Z * 0.9),
				head * at(0, 0, h.Z * 0.35),
				BROWN,
				Enum.PartType.Ball
			)
		elseif extra == "tail" then
			makePart(
				model,
				"Tail",
				Vector3.new(0.25, 0.25, 2.0),
				at(0, bodyY + 0.2, body.Z / 2 + 0.8) * CFrame.Angles(math.rad(35), 0, 0),
				v.bodyColor
			)
			makePart(model, "TailTip", Vector3.new(0.5, 0.5, 0.5), at(0, bodyY - 0.4, body.Z / 2 + 1.6), BROWN, Enum.PartType.Ball)
		elseif extra == "spots" then
			local spotColor = Color3.fromRGB(140, 85, 35)
			for i = 1, 6 do
				local side = if i % 2 == 0 then 1 else -1
				local z = (i - 3.5) * body.Z / 7
				local y = bodyY + (if i % 3 == 0 then 0.5 else -0.3)
				makePart(model, "Spot", Vector3.new(0.08, 0.7, 0.7), at(side * (body.X / 2 + 0.02), y, z), spotColor)
			end
		elseif extra == "ossicones" then
			for _, side in { -1, 1 } do
				makePart(model, "Ossicone", Vector3.new(0.2, 0.6, 0.2), head * at(side * 0.25, h.Y / 2 + 0.3, 0.4), BROWN)
			end
		elseif extra == "trunk" then
			local trunkColor = v.headColor
			makePart(model, "Trunk", Vector3.new(0.8, 1.6, 0.8), head * at(0, -0.6, -h.Z / 2 - 0.3), trunkColor)
			makePart(
				model,
				"Trunk",
				Vector3.new(0.6, 1.6, 0.6),
				head * at(0, -2.0, -h.Z / 2 - 0.5) * CFrame.Angles(math.rad(-15), 0, 0),
				trunkColor
			)
		elseif extra == "bigEars" then
			for _, side in { -1, 1 } do
				makePart(
					model,
					"Ear",
					Vector3.new(0.2, 2.6, 2.0),
					head * at(side * (h.X / 2 + 0.2), 0, 0.4) * CFrame.Angles(0, side * math.rad(-20), 0),
					v.headColor:Lerp(PINK, 0.15)
				)
			end
		elseif extra == "tusks" then
			for _, side in { -1, 1 } do
				makePart(
					model,
					"Tusk",
					Vector3.new(0.25, 0.25, 1.4),
					head * at(side * 0.6, -h.Y / 2 + 0.2, -h.Z / 2 - 0.4) * CFrame.Angles(math.rad(20), 0, 0),
					IVORY
				)
			end
		end
	end
end

local function buildBiped(model: Model, v: Config.Visual)
	local body = v.bodySize
	local legLength = v.legLength
	local bodyY = legLength + body.Y / 2
	makePart(model, "Body", body, at(0, bodyY, 0), v.bodyColor)

	for _, side in { -1, 1 } do
		makePart(
			model,
			"Foot",
			Vector3.new(0.5, legLength + 0.1, 0.8),
			at(side * body.X * 0.25, (legLength + 0.1) / 2, -0.2),
			v.legColor
		)
	end

	local head = at(0, legLength + body.Y + v.headSize.Y / 2 - 0.1, 0)
	makePart(model, "Head", v.headSize, head, v.headColor)
	addEyes(model, head, v.headSize)

	for _, extra in v.extras do
		if extra == "whiteBelly" then
			makePart(
				model,
				"Belly",
				Vector3.new(body.X * 0.75, body.Y * 0.8, 0.1),
				at(0, bodyY - body.Y * 0.05, -body.Z / 2 - 0.01),
				WHITE
			)
		elseif extra == "beak" then
			makePart(model, "Beak", Vector3.new(0.35, 0.25, 0.6), head * at(0, -0.1, -v.headSize.Z / 2 - 0.25), ORANGE)
		elseif extra == "flippers" then
			for _, side in { -1, 1 } do
				makePart(
					model,
					"Flipper",
					Vector3.new(0.2, body.Y * 0.6, 0.6),
					at(side * (body.X / 2 + 0.1), bodyY, 0) * CFrame.Angles(0, 0, side * math.rad(15)),
					v.bodyColor
				)
			end
		end
	end
end

function AnimalBuilder.build(speciesId: string): Model
	local species = Config.SpeciesById[speciesId]
	assert(species, "Unknown species " .. tostring(speciesId))

	local model = Instance.new("Model")
	model.Name = species.name

	if species.visual.shape == "biped" then
		buildBiped(model, species.visual)
	else
		buildQuadruped(model, species.visual)
	end

	model.WorldPivot = CFrame.new()
	return model
end

return AnimalBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Game balance and definitions shared by server and client.

export type Visual = {
	shape: string, -- "quadruped" or "biped"
	bodyColor: Color3,
	headColor: Color3,
	legColor: Color3,
	bodySize: Vector3,
	headSize: Vector3,
	legLength: number,
	extras: { string },
}

export type Species = {
	id: string,
	name: string,
	price: number, -- cost to buy a baby
	food: string, -- id of the food it eats
	mealSize: number, -- food units eaten per meal
	growTime: number, -- seconds of being fed needed to reach adult
	income: number, -- coins per second from visitors, adults only
	sellPrice: number, -- what an adult sells for
	rating: number, -- zoo rating each adult adds
	speed: number, -- wander speed in studs/second
	habitat: Color3, -- pen floor colour
	habitatMaterial: Enum.Material,
	visual: Visual,
}

export type Food = {
	id: string,
	name: string,
	emoji: string,
	ring: number, -- which wild ring it grows in (further = rarer)
	yield: number, -- units gathered per forage
	harvestTime: number, -- seconds to forage with basic gloves
}

export type Ring = {
	name: string,
	inner: number, -- distance from the centre of the map
	outer: number,
	color: Color3,
	material: Enum.Material,
}

export type Equipment = {
	id: string,
	name: string,
	emoji: string,
	description: string,
	tierNames: { string },
	values: { number }, -- value at level 0, 1, 2, ... (index = level + 1)
}

local Config = {}

Config.StartingCoins = 150
Config.PenCapacity = 3
Config.PenSize = 24
Config.PenPrices = { 0, 0, 200, 500, 1200, 3000, 7000, 15000 }
Config.MaxPlots = 6

-- Hunger and health
Config.HungerMax = 100
Config.HungerDrainPerSecond = 100 / 240 -- a full belly lasts four minutes
Config.EatThreshold = 40 -- animals eat from the pen's food store below this
Config.WellFedThreshold = 50 -- below this, animals grow at half speed
Config.HealthMax = 100
Config.StarveDamagePerSecond = 100 / 90 -- a starving animal dies after 90 seconds
Config.HealthRegenPerSecond = 2

Config.BabyStageEnd = 0.4 -- growth fraction where a baby becomes a juvenile
Config.StageScale = { Baby = 0.45, Juvenile = 0.7, Adult = 1 }

Config.BreedCooldown = 60 -- seconds between births in one pen
Config.BreedChancePerSecond = 1 / 20
Config.BreedMinHunger = 30

Config.DiscoveryRewardMultiplier = 2 -- first adult of a species pays price * this
Config.DiscoveryRating = 5 -- rating per species in the Zoo Book
Config.BabySellFraction = 0.5 -- non-adults sell for this share of their price

Config.AutosaveInterval = 60

-- Foraging
Config.StockDistance = 20 -- how close to a pen sign you must be to stock it
Config.NodesPerFood = 8
Config.NodeRegrowTime = 20
Config.ChestsPerRing = { 4, 3, 3, 2 }
Config.ChestRespawnTime = 45
Config.ChestCoinRewards = { 60, 200, 600, 1500 } -- when a chest has no upgrade left for you

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Wild areas around the zoo. Rarer food grows further out.
Config.Rings = {
	{ name = "Meadow", inner = 200, outer = 300, color = rgb(140, 195, 95), material = Enum.Material.Grass },
	{ name = "Plains", inner = 300, outer = 420, color = rgb(195, 185, 105), material = Enum.Material.Grass },
	{ name = "Forest", inner = 420, outer = 560, color = rgb(60, 115, 55), material = Enum.Material.LeafyGrass },
	{ name = "Savanna", inner = 560, outer = 720, color = rgb(210, 165, 95), material = Enum.Material.Sand },
} :: { Ring }

Config.Foods = {
	{ id = "Carrot", name = "Carrots", emoji = "🥕", ring = 1, yield = 5, harvestTime = 2 },
	{ id = "Fish", name = "Fish", emoji = "🐟", ring = 1, yield = 5, harvestTime = 2.5 },
	{ id = "Hay", name = "Hay", emoji = "🌾", ring = 2, yield = 6, harvestTime = 3 },
	{ id = "Bamboo", name = "Bamboo", emoji = "🎋", ring = 3, yield = 8, harvestTime = 3.5 },
	{ id = "Meat", name = "Meat", emoji = "🥩", ring = 3, yield = 8, harvestTime = 3.5 },
	{ id = "Leaves", name = "Acacia Leaves", emoji = "🌿", ring = 4, yield = 10, harvestTime = 4 },
	{ id = "Melon", name = "Melons", emoji = "🍉", ring = 4, yield = 10, harvestTime = 4 },
} :: { Food }

Config.FoodById = {} :: { [string]: Food }
for _, food in Config.Foods do
	Config.FoodById[food.id] = food
end

-- Equipment found in chests. Level 0 is what you start with.
Config.Equipment = {
	{
		id = "Gloves",
		name = "Gloves",
		emoji = "🧤",
		description = "Forage faster",
		tierNames = { "Bare Hands", "Work Gloves", "Sturdy Gloves", "Expert Gloves", "Legendary Gloves" },
		values = { 1, 0.75, 0.55, 0.4, 0.3 }, -- foraging time multiplier
	},
	{
		id = "Backpack",
		name = "Backpack",
		emoji = "🎒",
		description = "Carry more food",
		tierNames = { "Small Pouch", "Satchel", "Backpack", "Explorer Pack", "Legendary Pack" },
		values = { 15, 25, 40, 60, 90 }, -- food units you can carry
	},
	{
		id = "Pantry",
		name = "Pantry",
		emoji = "🏠",
		description = "Bigger pen food stores",
		tierNames = { "Small Bin", "Crate", "Pantry", "Storehouse", "Legendary Silo" },
		values = { 30, 50, 80, 120, 180 }, -- food units each pen can store
	},
	{
		id = "Boots",
		name = "Boots",
		emoji = "👢",
		description = "Walk faster",
		tierNames = { "Old Sneakers", "Trail Shoes", "Hiking Boots", "Explorer Boots", "Legendary Boots" },
		values = { 16, 19, 22, 26, 30 }, -- walk speed (Roblox default is 16)
	},
} :: { Equipment }

Config.EquipmentById = {} :: { [string]: Equipment }
for _, equipment in Config.Equipment do
	Config.EquipmentById[equipment.id] = equipment
end

Config.MaxEquipmentLevel = 4

Config.Species = {
	{
		id = "Rabbit",
		name = "Rabbit",
		price = 40,
		food = "Carrot",
		mealSize = 1,
		growTime = 45,
		income = 1,
		sellPrice = 90,
		rating = 1,
		speed = 6,
		habitat = rgb(106, 170, 78),
		habitatMaterial = Enum.Material.Grass,
		visual = {
			shape = "quadruped",
			bodyColor = rgb(235, 225, 215),
			headColor = rgb(240, 232, 222),
			legColor = rgb(225, 215, 205),
			bodySize = Vector3.new(1.6, 1.4, 2.2),
			headSize = Vector3.new(1.2, 1.2, 1.2),
			legLength = 0.5,
			extras = { "longEars", "puffTail" },
		},
	},
	{
		id = "Penguin",
		name = "Penguin",
		price = 120,
		food = "Fish",
		mealSize = 1,
		growTime = 75,
		income = 3,
		sellPrice = 260,
		rating = 2,
		speed = 3,
		habitat = rgb(215, 235, 245),
		habitatMaterial = Enum.Material.Ice,
		visual = {
			shape = "biped",
			bodyColor = rgb(30, 30, 35),
			headColor = rgb(30, 30, 35),
			legColor = rgb(245, 160, 40),
			bodySize = Vector3.new(1.6, 2.4, 1.4),
			headSize = Vector3.new(1.1, 1.1, 1.1),
			legLength = 0.3,
			extras = { "whiteBelly", "beak", "flippers" },
		},
	},
	{
		id = "Goat",
		name = "Goat",
		price = 300,
		food = "Hay",
		mealSize = 2,
		growTime = 100,
		income = 6,
		sellPrice = 600,
		rating = 4,
		speed = 5,
		habitat = rgb(140, 135, 120),
		habitatMaterial = Enum.Material.Slate,
		visual = {
			shape = "quadruped",
			bodyColor = rgb(200, 190, 170),
			headColor = rgb(210, 200, 180),
			legColor = rgb(170, 160, 140),
			bodySize = Vector3.new(1.8, 1.8, 3.2),
			headSize = Vector3.new(1.1, 1.3, 1.5),
			legLength = 1.6,
			extras = { "horns", "beard" },
		},
	},
	{
		id = "Zebra",
		name = "Zebra",
		price = 700,
		food = "Hay",
		mealSize = 2,
		growTime = 140,
		income = 12,
		sellPrice = 1400,
		rating = 7,
		speed = 7,
		habitat = rgb(205, 185, 120),
		habitatMaterial = Enum.Material.Sand,
		visual = {
			shape = "quadruped",
			bodyColor = rgb(245, 245, 245),
			headColor = rgb(245, 245, 245),
			legColor = rgb(240, 240, 240),
			bodySize = Vector3.new(2.2, 2.2, 4.2),
			headSize = Vector3.new(1.2, 1.4, 2.0),
			legLength = 2.4,
			extras = { "stripes", "mane" },
		},
	},
	{
		id = "Panda",
		name = "Panda",
		price = 1500,
		food = "Bamboo",
		mealSize = 3,
		growTime = 180,
		income = 25,
		sellPrice = 3000,
		rating = 11,
		speed = 2.5,
		habitat = rgb(80, 150, 70),
		habitatMaterial = Enum.Material.LeafyGrass,
		visual = {
			shape = "quadruped",
			bodyColor = rgb(245, 245, 245),
			headColor = rgb(245, 245, 245),
			legColor = rgb(25, 25, 25),
			bodySize = Vector3.new(3.0, 2.8, 3.8),
			headSize = Vector3.new(2.2, 2.0, 2.0),
			legLength = 1.2,
			extras = { "roundEars", "eyePatches" },
		},
	},
	{
		id = "Lion",
		name = "Lion",
		price = 3000,
		food = "Meat",
		mealSize = 3,
		growTime = 240,
		income = 45,
		sellPrice = 6000,
		rating = 16,
		speed = 6,
		habitat = rgb(215, 180, 100),
		habitatMaterial = Enum.Material.Sand,
		visual = {
			shape = "quadruped",
			bodyColor = rgb(215, 160, 80),
			headColor = rgb(225, 170, 90),
			legColor = rgb(205, 150, 70),
			bodySize = Vector3.new(2.4, 2.4, 4.4),
			headSize = Vector3.new(1.8, 1.8, 1.8),
			legLength = 2.0,
			extras = { "lionMane", "tail" },
		},
	},
	{
		id = "Giraffe",
		name = "Giraffe",
		price = 6000,
		food = "Leaves",
		mealSize = 4,
		growTime = 300,
		income = 80,
		sellPrice = 12000,
		rating = 22,
		speed = 4,
		habitat = rgb(190, 175, 110),
		habitatMaterial = Enum.Material.Ground,
		visual = {
			shape = "quadruped",
			bodyColor = rgb(230, 180, 90),
			headColor = rgb(230, 180, 90),
			legColor = rgb(220, 170, 85),
			bodySize = Vector3.new(2.4, 2.6, 4.0),
			headSize = Vector3.new(1.0, 1.2, 2.0),
			legLength = 4.0,
			extras = { "longNeck", "spots", "ossicones" },
		},
	},
	{
		id = "Elephant",
		name = "Elephant",
		price = 12000,
		food = "Melon",
		mealSize = 5,
		growTime = 360,
		income = 150,
		sellPrice = 24000,
		rating = 30,
		speed = 3,
		habitat = rgb(150, 115, 80),
		habitatMaterial = Enum.Material.Mud,
		visual = {
			shape = "quadruped",
			bodyColor = rgb(140, 140, 150),
			headColor = rgb(145, 145, 155),
			legColor = rgb(130, 130, 140),
			bodySize = Vector3.new(4.4, 4.0, 6.0),
			headSize = Vector3.new(2.8, 2.8, 2.4),
			legLength = 2.8,
			extras = { "trunk", "bigEars", "tusks" },
		},
	},
} :: { Species }

Config.SpeciesById = {} :: { [string]: Species }
for _, species in Config.Species do
	Config.SpeciesById[species.id] = species
end

function Config.getStage(species: Species, growth: number): string
	local fraction = growth / species.growTime
	if fraction >= 1 then
		return "Adult"
	elseif fraction >= Config.BabyStageEnd then
		return "Juvenile"
	end
	return "Baby"
end

function Config.getSellPrice(species: Species, growth: number): number
	if growth >= species.growTime then
		return species.sellPrice
	end
	return math.floor(species.price * Config.BabySellFraction)
end

function Config.getPenPrice(penIndex: number): number
	return Config.PenPrices[penIndex] or math.huge
end

function Config.getEquipmentValue(equipmentId: string, level: number): number
	local equipment = Config.EquipmentById[equipmentId]
	return equipment.values[math.clamp(level, 0, Config.MaxEquipmentLevel) + 1]
end

return Config
]]></string>
        </Properties>
      </Item>
